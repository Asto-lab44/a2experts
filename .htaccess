# ============================================================
# A2EXPERTS — .htaccess (Apache 2.4+)
# Redirections, sécurité, performance, URLs propres
# ============================================================

# --- Encodage par défaut --------------------------------------
AddDefaultCharset UTF-8

# --- Page d'accueil et erreurs --------------------------------
DirectoryIndex index.html
ErrorDocument 404 /index.html

# --- Réécriture d'URL -----------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1) Forcer HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2) Forcer le sous-domaine www
  RewriteCond %{HTTP_HOST} ^a2experts\.fr$ [NC]
  RewriteRule ^ https://www.a2experts.fr%{REQUEST_URI} [L,R=301]

  # 3) Redirection de l'ancien domaine astorya.fr vers a2experts.fr
  RewriteCond %{HTTP_HOST} ^(www\.)?astorya\.fr$ [NC]
  RewriteRule ^ https://www.a2experts.fr%{REQUEST_URI} [L,R=301]

  # 4) URLs propres : permettre /contact au lieu de /contact.html
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^([^.]+)$ $1.html [L]

  # 5) Masquer l'extension .html dans l'URL visible
  RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
  RewriteRule ^ /%1 [L,R=301]
</IfModule>

# --- En-têtes de sécurité -------------------------------------
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
  Header always set X-XSS-Protection "1; mode=block"

  # Cache long pour les statiques
  <FilesMatch "\.(css|js|jpg|jpeg|png|gif|webp|svg|woff|woff2|ttf|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Pas de cache pour les HTML
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>
</IfModule>

# --- Compression GZIP -----------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# --- Cache navigateur (Expires) -------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                                "access plus 1 month"
  ExpiresByType text/html                       "access plus 1 hour"
  ExpiresByType text/css                        "access plus 1 year"
  ExpiresByType application/javascript          "access plus 1 year"
  ExpiresByType image/jpeg                      "access plus 1 year"
  ExpiresByType image/png                       "access plus 1 year"
  ExpiresByType image/webp                      "access plus 1 year"
  ExpiresByType image/svg+xml                   "access plus 1 year"
  ExpiresByType font/woff2                      "access plus 1 year"
  ExpiresByType application/xml                 "access plus 1 day"
</IfModule>

# --- Bloquer l'accès aux fichiers sensibles -------------------
<FilesMatch "(\.htaccess|\.git|\.env|composer\.json|package\.json|\.md|\.jsx|README)">
  Require all denied
</FilesMatch>

# --- Bloquer la liste de répertoires --------------------------
Options -Indexes
